#!/usr/bin/env bash
set -euo pipefail
exec > >(tee /tmp/gpt-os-install.log) 2>&1
[[ $EUID -eq 0 && $# -eq 6 ]] || exit 2
disk="$1" user="$2" home_name="$3" host="$4" timezone="$5" password="$6"
[[ -b "$disk" && "$disk" == /dev/* ]] || exit 3
[[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 4
[[ "$home_name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 4
[[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$ ]] || exit 4
[[ -e "/usr/share/zoneinfo/$timezone" ]] || timezone=UTC

swapoff -a || true
umount -R /mnt 2>/dev/null || true
wipefs -af "$disk"
parted -s "$disk" mklabel gpt mkpart ESP fat32 1MiB 1025MiB set 1 esp on mkpart MEMBRANE btrfs 1025MiB 100%
suffix=""; [[ "$disk" =~ [0-9]$ ]] && suffix=p
esp="${disk}${suffix}1" root="${disk}${suffix}2"
udevadm settle
mkfs.fat -F32 -n MEMBRANEEFI "$esp"
mkfs.btrfs -f -L MEMBRANE_OS "$root"
mount "$root" /mnt
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home
umount /mnt
mount -o subvol=@,compress=zstd,noatime "$root" /mnt
mkdir -p /mnt/{boot,home}
mount -o subvol=@home,compress=zstd,noatime "$root" /mnt/home
mount "$esp" /mnt/boot
pacstrap -K /mnt base linux linux-firmware networkmanager plasma-meta plasma-wayland-session sddm konsole dolphin firefox sudo grub efibootmgr pipewire pipewire-pulse wireplumber
genfstab -U /mnt >> /mnt/etc/fstab
cp -a /etc/skel/. /mnt/etc/skel/
cp -a /usr/bin/gpt-welcome /mnt/usr/local/bin/gpt-welcome
echo "$host" > /mnt/etc/hostname
ln -sf "/usr/share/zoneinfo/$timezone" /mnt/etc/localtime
arch-chroot /mnt hwclock --systohc
arch-chroot /mnt useradd -m -d "/home/$home_name" -G wheel,video,audio,storage -s /bin/bash "$user"
printf '%s:%s\n' "$user" "$password" | arch-chroot /mnt chpasswd
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /mnt/etc/sudoers.d/10-wheel
arch-chroot /mnt systemctl enable NetworkManager sddm
arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=MembraneOS
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Membrane OS Captain"/' /mnt/etc/default/grub
arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg
install -Dm644 /dev/null "/mnt/home/$home_name/.config/gpt-os/first-boot"
arch-chroot /mnt chown -R "$user:$user" "/home/$home_name"
sync
