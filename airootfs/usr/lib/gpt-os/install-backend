#!/usr/bin/env bash
set -euo pipefail
exec > >(tee /tmp/gpt-os-install.log) 2>&1
[[ $EUID -eq 0 && $# -eq 6 ]] || exit 2
disk="$1" user="$2" home_name="$3" host="$4" timezone="$5" password="$6"
[[ -b "$disk" && "$disk" == /dev/* ]] || exit 3
[[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 4
[[ "$home_name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 4
[[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$ ]] || exit 4
[[ -e "/usr/share/zoneinfo/$timezone" ]] || timezone=UTC

# Never inherit a working directory below the installation target. A process
# whose cwd is inside /mnt keeps the mount busy even when no files are open.
cd /

unmount_install_tree() {
    local attempt
    for attempt in {1..10}; do
        mountpoint -q /mnt || return 0
        umount -R /mnt 2>/dev/null && return 0

        # pacstrap's target keyring can leave a gpg-agent attached to files
        # below /mnt, including after an interrupted installation. Ask that
        # exact agent to stop, then terminate only processes still using the
        # installation mount. The backend itself runs from / and is unaffected.
        gpgconf --homedir /mnt/etc/pacman.d/gnupg --kill gpg-agent \
            2>/dev/null || true
        fuser -km -TERM -- /mnt 2>/dev/null || true
        sync
        sleep 0.5
    done
    echo "Unable to release installation mount /mnt"
    findmnt -R /mnt || true
    fuser -vm /mnt || true
    return 1
}

swapoff -a || true
unmount_install_tree

# A previously formatted virtual disk may have been auto-mounted by udisks.
# Unmount every child of the selected disk before replacing its partition table.
mapfile -t disk_children < <(lsblk -lnpo NAME "$disk" | tail -n +2 | tac)
for device in "${disk_children[@]}"; do
    while read -r target; do
        [[ -n "$target" ]] && umount "$target"
    done < <(findmnt -rn -S "$device" -o TARGET || true)
    swapoff "$device" 2>/dev/null || true
done

# Remove stale signatures from the children first, then from the whole disk.
for device in "${disk_children[@]}"; do
    wipefs -af "$device" 2>/dev/null || true
done
wipefs -af "$disk"
parted -s "$disk" mklabel gpt mkpart ESP fat32 1MiB 1025MiB set 1 esp on mkpart MEMBRANE btrfs 1025MiB 100%
suffix=""; [[ "$disk" =~ [0-9]$ ]] && suffix=p
esp="${disk}${suffix}1" root="${disk}${suffix}2"
partprobe "$disk"
blockdev --rereadpt "$disk" 2>/dev/null || true
udevadm settle
for device in "$esp" "$root"; do
    for _ in {1..50}; do
        [[ -b "$device" ]] && break
        sleep 0.1
    done
    [[ -b "$device" ]] || { echo "Partition device did not appear: $device"; exit 5; }
done
mkfs.fat -F32 -n MEMBRANEEFI "$esp"
mkfs.btrfs -f -L MEMBRANE_OS "$root"
mount "$root" /mnt
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home
unmount_install_tree
mount -o subvol=@,compress=zstd,noatime "$root" /mnt
mkdir -p /mnt/{boot,home}
mount -o subvol=@home,compress=zstd,noatime "$root" /mnt/home
mount "$esp" /mnt/boot
# Refuse to erase/install further if the live environment has no usable
# repository server.  ArchISO's build-host mirrorlist is not automatically
# guaranteed to exist in the booted image.
if ! grep -Eq '^[[:space:]]*Server[[:space:]]*=' /etc/pacman.d/mirrorlist; then
    echo "No Arch Linux package mirrors are configured."
    exit 6
fi
pacman -Syy --noconfirm
pacstrap -K /mnt base linux linux-firmware networkmanager plasma-meta plasma-x11-session kdeplasma-addons sddm konsole dolphin ark discover gwenview spectacle okular firefox sudo grub efibootmgr pipewire pipewire-pulse wireplumber
genfstab -U /mnt >> /mnt/etc/fstab
cp -a /etc/skel/. /mnt/etc/skel/
cp -a /usr/bin/gpt-welcome /mnt/usr/local/bin/gpt-welcome
# Preserve the complete Membrane visual system in the installed OS.
cp -a /usr/share/icons/Membrane /mnt/usr/share/icons/
cp -a /usr/share/color-schemes/Membrane*.colors /mnt/usr/share/color-schemes/
cp -a /usr/share/plasma/look-and-feel/org.membrane.* /mnt/usr/share/plasma/look-and-feel/
cp -a /usr/share/plasma/desktoptheme/Membrane* /mnt/usr/share/plasma/desktoptheme/
cp -a /usr/share/wallpapers/MembraneOS-* /mnt/usr/share/wallpapers/
# The installed user's Plasma session uses the same delayed containment setup
# as the live session.  Copy both halves; previously /etc/skel referenced a
# helper that only existed on the ISO, so the installed wallpaper setup never
# ran.
install -Dm755 /usr/local/bin/membrane-recovery-desktop \
  /mnt/usr/local/bin/membrane-recovery-desktop
install -Dm644 /usr/local/share/membrane-os/recovery-desktop.js \
  /mnt/usr/local/share/membrane-os/recovery-desktop.js
echo "$host" > /mnt/etc/hostname
ln -sf "/usr/share/zoneinfo/$timezone" /mnt/etc/localtime
arch-chroot /mnt hwclock --systohc
arch-chroot /mnt useradd -m -d "/home/$home_name" -G wheel,video,audio,storage -s /bin/bash "$user"
printf '%s:%s\n' "$user" "$password" | arch-chroot /mnt chpasswd
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /mnt/etc/sudoers.d/10-wheel
arch-chroot /mnt systemctl enable NetworkManager sddm
arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=MembraneOS
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Membrane OS Captain"/' /mnt/etc/default/grub
arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg
install -Dm644 /dev/null "/mnt/home/$home_name/.config/gpt-os/first-boot"
arch-chroot /mnt chown -R "$user:$user" "/home/$home_name"
sync
