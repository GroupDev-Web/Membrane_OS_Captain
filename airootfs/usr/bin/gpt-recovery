#!/usr/bin/env python3
import os, re, subprocess
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gio, Gdk

Adw.init()

CSS = b"""
/* The recovery session may use either Membrane theme.  Do not inherit its
 * foreground palette: the installer is intentionally a light surface and
 * must remain readable under Dark, Light, and both Liquid Glue variants. */
window, dialog { background: linear-gradient(135deg,#dfe9f3,#ffffff); color: #172033; }
window *, dialog * { color: #172033; }
label, checkbutton, checkbutton label, grid label, box label { color: #172033; }
.hero { font-size: 30px; font-weight: 700; color: #172033; }
.sub { color: #566176; }
.card { background: rgba(255,255,255,.86); border-radius: 18px; padding: 22px;
        box-shadow: 0 12px 35px rgba(20,35,60,.12); }
entry, passwordentry, combobox, dropdown {
    color: #172033;
    background: rgba(255,255,255,.96);
    border: 1px solid rgba(23,32,51,.25);
}
entry text, passwordentry text, combobox *, dropdown * { color: #172033; }
button {
    color: #172033;
    background: rgba(245,248,252,.96);
    border: 1px solid rgba(23,32,51,.18);
}
button label { color: #172033; }
checkbutton check {
    color: #172033;
    background: #ffffff;
    border: 1px solid #566176;
}
checkbutton:checked check { color: #ffffff; background: #147ce5; }
.primary { background: #147ce5; color: #ffffff; border-radius: 10px; padding: 10px; }
.primary label { color: #ffffff; }
.error, .error label { color: #a51d2d; }
.recovery-action {
    color: #172033;
    background: rgba(255,255,255,.72);
    border: 1px solid rgba(23,32,51,.12);
    border-radius: 14px;
    font-weight: 600;
}
.recovery-action:hover { background: rgba(255,255,255,.90); }
.recovery-action:active { background: rgba(220,230,244,.94); }
.recovery-action label { color: #172033; }
"""

def run(*args): subprocess.Popen(args)

class Installer(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Install Membrane OS Captain")
        self.set_default_size(860, 600); self.set_resizable(False)
        self.data = {}; self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.set_child(self.stack)
        self.pages = [self.license_page(), self.network_page(), self.disk_page(),
                      self.account_page(), self.computer_page(), self.review_page()]
        for i,p in enumerate(self.pages): self.stack.add_named(p, str(i))
        self.index=0; self.stack.set_visible_child_name("0")

    def frame(self, title, subtitle, body, final=False):
        box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin_top=42,
                    margin_bottom=32, margin_start=64, margin_end=64)
        t=Gtk.Label(label=title, xalign=0); t.add_css_class("hero"); box.append(t)
        s=Gtk.Label(label=subtitle, xalign=0, wrap=True); s.add_css_class("sub"); box.append(s)
        body.set_vexpand(True); body.add_css_class("card"); box.append(body)
        nav=Gtk.Box(spacing=10, halign=Gtk.Align.END)
        back=Gtk.Button(label="Back"); back.connect("clicked",lambda *_:self.go(-1)); nav.append(back)
        nxt=Gtk.Button(label="Install" if final else "Continue"); nxt.add_css_class("primary")
        nxt.connect("clicked", self.install if final else lambda *_:self.go(1)); nav.append(nxt); box.append(nav)
        return box

    def go(self, d):
        if not self.validate(): return
        self.index=max(0,min(len(self.pages)-1,self.index+d))
        if self.index==5: self.refresh_review()
        self.stack.set_visible_child_name(str(self.index))

    def alert(self, msg):
        d=Adw.MessageDialog(transient_for=self, heading="Before you continue", body=msg)
        d.add_response("ok","OK"); d.present()

    def validate(self):
        if self.index==0 and not self.tos.get_active(): self.alert("You must agree to the Membrane OS Terms of Service."); return False
        if self.index==1 and subprocess.run(["nm-online","-q","--timeout=2"]).returncode: self.alert("You need a Wi‑Fi or wired network to install Membrane OS Captain."); return False
        if self.index==2 and not self.disk.get_active_id(): self.alert("Choose a disk to install Membrane OS Captain on."); return False
        if self.index==3:
            u,h=self.user.get_text(),self.home.get_text()
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}",u) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}",h): self.alert("Username and home folder must use lowercase letters, numbers, _ or -."); return False
            if len(self.password.get_text())<6: self.alert("Use a password with at least 6 characters."); return False
        return True

    def license_page(self):
        b=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=12)
        b.append(Gtk.Label(label="Membrane OS is provided without warranty. Installation can erase data.\nReview the project terms before continuing.",wrap=True,xalign=0))
        self.tos=Gtk.CheckButton(label="I agree to the Membrane OS Terms of Service") ; b.append(self.tos)
        return self.frame("Do you agree to the TOS?","Please read the terms before installing.",b)

    def network_page(self):
        b=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14)
        b.append(Gtk.Label(label="Membrane OS downloads current Arch packages during installation.",xalign=0,wrap=True))
        x=Gtk.Button(label="Open Network Settings"); x.connect("clicked",lambda *_:run("plasmawindowed","org.kde.plasma.networkmanagement")); b.append(x)
        return self.frame("Connect to the internet","You need a Wi‑Fi network to install Membrane OS Captain.",b)

    def disk_page(self):
        b=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=12)
        self.disk=Gtk.ComboBoxText()
        out=subprocess.check_output(["lsblk","-dnp","-o","NAME,SIZE,MODEL","-e","7,11"],text=True)
        for line in out.splitlines():
            dev=line.split()[0]; self.disk.append(dev,line)
        b.append(self.disk)
        warn=Gtk.Label(label="The selected disk will be completely erased. Back up your files first.",wrap=True,xalign=0); warn.add_css_class("error"); b.append(warn)
        x=Gtk.Button(label="Open Disk Management"); x.connect("clicked",lambda *_:run("pkexec","gparted")); b.append(x)
        return self.frame("Choose a disk","Choose a disk/partition to install Membrane OS Captain on.",b)

    def account_page(self):
        g=Gtk.Grid(column_spacing=14,row_spacing=14)
        self.user,self.home,self.password=Gtk.Entry(),Gtk.Entry(),Gtk.PasswordEntry()
        self.user.connect("changed",lambda w:self.home.set_text(w.get_text()) if not self.home.has_focus() else None)
        for r,(name,w) in enumerate((("Username",self.user),("Home folder name",self.home),("Password",self.password))): g.attach(Gtk.Label(label=name,xalign=0),0,r,1,1); g.attach(w,1,r,1,1)
        return self.frame("Create your account","Choose your username and home folder name.",g)

    def computer_page(self):
        g=Gtk.Grid(column_spacing=14,row_spacing=14)
        self.hostname=Gtk.Entry(text="membrane-os"); self.timezone=Gtk.Entry(text="UTC")
        g.attach(Gtk.Label(label="Computer name",xalign=0),0,0,1,1); g.attach(self.hostname,1,0,1,1)
        g.attach(Gtk.Label(label="Timezone",xalign=0),0,1,1,1); g.attach(self.timezone,1,1,1,1)
        return self.frame("Name your PC","This name identifies your computer on local networks.",g)

    def review_page(self):
        self.review=Gtk.Label(xalign=0,wrap=True,selectable=True)
        return self.frame("Ready to install","Review your choices. This cannot be undone.",self.review,True)

    def refresh_review(self):
        self.review.set_text(f"Edition: Membrane OS Captain\nDisk: {self.disk.get_active_id()} (ERASED)\nUser: {self.user.get_text()}\nHome: /home/{self.home.get_text()}\nComputer: {self.hostname.get_text()}\nTimezone: {self.timezone.get_text()}")

    def install(self,*_):
        args=["pkexec","/usr/lib/gpt-os/install-backend",self.disk.get_active_id(),self.user.get_text(),self.home.get_text(),self.hostname.get_text(),self.timezone.get_text(),self.password.get_text()]
        p=subprocess.Popen(args); p.wait()
        d=Adw.MessageDialog(transient_for=self,heading="Installation complete" if p.returncode==0 else "Installation failed",body="Restart to begin using Membrane OS Captain." if p.returncode==0 else "No changes are guaranteed. Review /tmp/gpt-os-install.log before retrying.")
        d.add_response("ok","OK"); d.present()

class Recovery(Gtk.Application):
    def do_activate(self):
        win=Adw.ApplicationWindow(application=self,title="Membrane OS Recovery"); win.set_default_size(960,650)
        box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=18,halign=Gtk.Align.CENTER,valign=Gtk.Align.CENTER)
        t=Gtk.Label(label="Membrane OS Recovery"); t.add_css_class("hero"); box.append(t)
        box.append(Gtk.Label(label="Repair, manage, or install Membrane OS Captain.",css_classes=["sub"]))
        grid=Gtk.Grid(column_spacing=12,row_spacing=12)
        actions=[("Install Membrane OS Captain",lambda *_:Installer(self).present()),("Open Disk Management",lambda *_:run("pkexec","gparted")),("Network Settings",lambda *_:run("plasmawindowed","org.kde.plasma.networkmanagement")),("Terminal",lambda *_:run("konsole")),("Restart",lambda *_:run("systemctl","reboot")),("Shut Down",lambda *_:run("systemctl","poweroff"))]
        for i,(label,cb) in enumerate(actions):
            b=Gtk.Button(label=label, css_classes=["recovery-action"])
            b.set_size_request(260,70); b.connect("clicked",cb); grid.attach(b,i%2,i//2,1,1)
        box.append(grid); win.set_content(box); win.present()

app=Recovery(application_id="org.gptos.Recovery")
provider=Gtk.CssProvider(); provider.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(),provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
app.run()
